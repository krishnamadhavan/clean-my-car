# Application
APP_ENV=development
DEBUG=true
API_PORT=8000

# PostgreSQL
POSTGRES_USER=cleanmycar
POSTGRES_PASSWORD=cleanmycar
POSTGRES_DB=cleanmycar
POSTGRES_PORT=5432

