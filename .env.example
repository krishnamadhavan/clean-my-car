# Copy to .env and adjust as needed:
#   cp .env.example .env

# Application
APP_ENV=development
DEBUG=true
API_PORT=8000

# PostgreSQL (application database)
POSTGRES_USER=cleanmycar
POSTGRES_PASSWORD=cleanmycar
POSTGRES_DB=cleanmycar
POSTGRES_PORT=5432
# Pytest uses a separate DB (created at suite start, dropped at end). Override if needed.
# POSTGRES_TEST_DB=cleanmycar_test
# POSTGRES_APP_DB=cleanmycar

# Optional explicit URL (compose also builds this for the api service)
# DATABASE_URL=postgresql+asyncpg://cleanmycar:cleanmycar@db:5432/cleanmycar

# Auth (change JWT_SECRET_KEY in any shared/staging/production environment)
JWT_SECRET_KEY=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# OTP
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5
# Force-include OTP in JSON response (also auto-enabled outside production)
OTP_RETURN_IN_RESPONSE=false

# Days after DELETE /me before the same phone can OTP-login again (Option B cool-off).
# Use 0 for immediate re-registration. Fractional values allowed (e.g. 0.5).
ACCOUNT_DELETION_COOLOFF_DAYS=1
